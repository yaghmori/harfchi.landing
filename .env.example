# Canonical site URL for SEO (Open Graph, sitemap, JSON-LD). Production default: https://harfchi.ir
# NEXT_PUBLIC_SITE_URL=https://harfchi.ir

# Search console verification (optional)
# GOOGLE_SITE_VERIFICATION=...
# YANDEX_SITE_VERIFICATION=...

# Public URL of the Harfchi API (optional — for future landing forms / fetch)
# NEXT_PUBLIC_API_URL=https://api.example.com

# Main game web app (enables the primary “ورود به بازی” CTA on the landing page)
# NEXT_PUBLIC_GAME_APP_URL=https://app.example.com

# Optional: add public/brand/gameplay-mobile.png (mobile gameplay screenshot) for the second phone mockup; until then the splash image is used.

# Landing: `public/assets/optimized/footer-background.png` (sky strip) + `footer.png` (family scene). Source: repo `assets/landing/optimized/`.

# Direct APK download at GET /download (place file on server, default: downloads/harfchi.apk)
# APP_DOWNLOAD_PATH=downloads/harfchi.apk
# APP_DOWNLOAD_FILENAME=harfchi.apk

# Store links for the landing download section
# NEXT_PUBLIC_CAFE_BAZAAR_URL=https://cafebazaar.ir/app/...
# NEXT_PUBLIC_SIBCHE_URL=https://sibche.com/applications/...
# PWA / web play (defaults to https://play.harfchi.ir)
# NEXT_PUBLIC_PWA_PLAY_URL=https://play.harfchi.ir
